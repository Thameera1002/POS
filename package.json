{
  "name": "saffron-pos",
  "version": "0.1.0",
  "description": "Modern restaurant POS with kitchen ticket printing",
  "main": "./out/main/index.js",
  "author": "Saffron POS",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:smoke": "esbuild test/smoke.ts --bundle --platform=node --format=cjs --external:electron --external:better-sqlite3 --outfile=out/smoke.cjs && rm -f out/smoke-test.db* && env -u ELECTRON_RUN_AS_NODE POS_DB_PATH=out/smoke-test.db electron out/smoke.cjs",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.30",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.19",
    "zustand": "^4.5.5"
  }
}
